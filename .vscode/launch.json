{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch current package",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "console": "integratedTerminal",
            "program": "${fileDirname}"
        },
        {
            "name": "fldrecall (no args)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "console": "integratedTerminal",
            "program": "${workspaceFolder}/cmd/fldrecall",
            "cwd": "${workspaceFolder}",
            "args": [
            ]
        },
        {
            "name": "fldrecall --version",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "console": "integratedTerminal",
            "program": "${workspaceFolder}/cmd/fldrecall",
            "cwd": "${workspaceFolder}",
            "args": [
                "--version"
            ]
        },
        {
            "name": "fldrecall --version (verbose)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "console": "integratedTerminal",
            "program": "${workspaceFolder}/cmd/fldrecall",
            "cwd": "${workspaceFolder}",
            "args": [
                "--version",
                "--verbose"
            ]
        },
        {
            "name": "fldrecall --help",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "console": "integratedTerminal",
            "program": "${workspaceFolder}/cmd/fldrecall",
            "cwd": "${workspaceFolder}",
            "args": [
                "--help"
            ]
        },
        {
            "name": "fldrecall -help",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "console": "integratedTerminal",
            "program": "${workspaceFolder}/cmd/fldrecall",
            "cwd": "${workspaceFolder}",
            "args": [
                "-help"
            ]
        },
        {
            "name": "fldrecall help",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "console": "integratedTerminal",
            "program": "${workspaceFolder}/cmd/fldrecall",
            "cwd": "${workspaceFolder}",
            "args": [
                "help"
            ]
        },
        {
            "name": "fldrecall -h",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "console": "integratedTerminal",
            "program": "${workspaceFolder}/cmd/fldrecall",
            "cwd": "${workspaceFolder}",
            "args": [
                "-h"
            ]
        },
        {
            "name": "fldrecall (error, missing argument value)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "console": "integratedTerminal",
            "program": "${workspaceFolder}/cmd/fldrecall",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "debug: reset sandbox",
            "args": [
                "--install"
            ]
        },
        {
            "name": "fldrecall (error, unknown argument)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "console": "integratedTerminal",
            "program": "${workspaceFolder}/cmd/fldrecall",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "debug: reset sandbox",
            "args": [
                "--i-do-not-exists"
            ]
        },
        {
            "name": "fldrecall --print",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "console": "integratedTerminal",
            "program": "${workspaceFolder}/cmd/fldrecall",
            "cwd": "${workspaceFolder}",
            "args": [
                "--print"
            ]
        },
        {
            "name": "fldrecall --monitor",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "console": "integratedTerminal",
            "program": "${workspaceFolder}/cmd/fldrecall",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "debug: reset sandbox",
            "args": [
                "--monitor",
                "--interval",
                "--30",
                "--dbpath",
                "${workspaceFolder}/.debug-sandbox/testdata/test-monitor.db"
            ]
        },
        {
            "name": "fldrecall --export",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "console": "integratedTerminal",
            "program": "${workspaceFolder}/cmd/fldrecall",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "debug: reset sandbox",
            "args": [
                "--export",
                "${workspaceFolder}/.debug-sandbox/testdata/mock-snapshots.exported.json",
                "--dbpath",
                "${workspaceFolder}/.debug-sandbox/testdata/mock-snapshots.db"
            ]
        }
    ]
}
